<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- White background -->
    <solid android:color="#FFFFFF" />

    <!-- Corner radius for rounded edges -->
    <corners android:radius="8dp" />

    <!-- Optional: Add shadow effect using padding and layer-list in a separate drawable -->
    <padding
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp" />

    <!-- Optional: Add subtle inner shadow/highlight -->
    <gradient
        android:startColor="#FFFFFF"
        android:endColor="#F5F5F5"
        android:angle="90"
        android:type="linear" />
</shape>