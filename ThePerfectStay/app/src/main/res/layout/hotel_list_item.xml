<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/img_hotel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Hotel Image"
                android:scaleType="centerCrop"
                tools:src="@drawable/hotel_room" />

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="$180/night" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_hotel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                tools:text="Hotel Name" />

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="@color/gray_dark"
                tools:text="Location" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/orange_button"
                    tools:text="4.5" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_star"
                    android:contentDescription="Star Rating"
                    app:tint="@color/orange_button"/>

                <TextView
                    android:id="@+id/tv_reviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="14sp"
                    android:textColor="@color/gray_dark"
                    tools:text="(5.1k Reviews)" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ic_beds"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Beds"
                    android:src="@drawable/ic_bed"
                    android:layout_marginEnd="8dp"/>

                <ImageView
                    android:id="@+id/ic_shower"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Shower"
                    android:src="@drawable/ic_shower"
                    android:layout_marginEnd="8dp"/>

                <ImageView
                    android:id="@+id/ic_hot_tub"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Hot Tub"
                    android:src="@drawable/ic_hot_tub"
                    android:layout_marginEnd="8dp"/>

                <ImageView
                    android:id="@+id/ic_ac"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Air Conditioning"
                    android:src="@drawable/ic_ac" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/gray_dark"
                android:textSize="14sp"
                tools:text="Hotel description goes here..." />

            <Button
                android:id="@+id/btn_book_now"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:layout_gravity="end"
                android:paddingHorizontal="24dp"
                android:backgroundTint="@color/orange_button"
                android:text="Book Now"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@color/white"
                app:cornerRadius="20dp"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>