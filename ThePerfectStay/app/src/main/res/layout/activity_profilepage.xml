<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".ProfileActivity">

    <ScrollView
        android:id="@+id/profile_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/profile_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:id="@+id/profile_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/back_button_description"
                    app:tint="@color/black"/> <TextView
                android:id="@+id/tv_profile_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btn_back"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true"
                android:text="Profile"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000" />

                <ImageView
                    android:id="@+id/btn_settings"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/settings_button_description"/> </RelativeLayout>

            <LinearLayout
                android:id="@+id/user_info_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/rounded_card"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:id="@+id/profile_image_container"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/orange_circle"> <ImageView
                    android:id="@+id/iv_profile_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_user"
                    app:tint="#FFFFFF"
                    android:contentDescription="@string/profile_icon_description"/> </FrameLayout>

                <LinearLayout
                    android:id="@+id/user_details_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emma Johnson" android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tv_user_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Full Name" android:textSize="14sp"
                        android:textColor="#757575" />

                </LinearLayout>

                <Button
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:backgroundTint="#FF5722" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_options_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card"
                android:divider="@drawable/divider" android:showDividers="middle">

                <LinearLayout
                    android:id="@+id/saved_hotels_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"> <ImageView
                    android:id="@+id/iv_saved_hotels_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_fave" android:layout_marginEnd="12dp"
                    app:tint="#757575"
                    android:contentDescription="@string/saved_hotels_icon_description"/> <TextView
                    android:id="@+id/tv_saved_hotels"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Saved Hotels"
                    android:textSize="16sp"
                    android:textColor="#000000" />

                    <ImageView
                        android:id="@+id/iv_saved_hotels_chevron"
                        android:layout_width="20dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_chevron_right" app:tint="#757575"
                        android:contentDescription="@string/chevron_right_description"/> </LinearLayout>

                <LinearLayout
                    android:id="@+id/my_bookings_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"> <ImageView
                    android:id="@+id/iv_bookings_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_calendar" android:layout_marginEnd="12dp"
                    app:tint="#757575"
                    android:contentDescription="@string/bookings_icon_description"/> <TextView
                    android:id="@+id/tv_my_bookings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="My Bookings"
                    android:textSize="16sp"
                    android:textColor="#000000" />

                    <ImageView
                        android:id="@+id/iv_bookings_chevron"
                        android:layout_width="20dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#757575"
                        android:contentDescription="@string/chevron_right_description"/> </LinearLayout>

                <LinearLayout
                    android:id="@+id/payment_methods_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"> <ImageView
                    android:id="@+id/iv_payment_icon"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_credit_card" app:tint="#757575"
                    android:contentDescription="@string/payment_methods_icon_description"/> <TextView
                    android:id="@+id/tv_payment_methods"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Payment Methods"
                    android:textSize="16sp"
                    android:textColor="#000000" />

                    <ImageView
                        android:id="@+id/iv_payment_chevron"
                        android:layout_width="20dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#757575"
                        android:contentDescription="@string/chevron_right_description"/> </LinearLayout>

                <LinearLayout
                    android:id="@+id/messages_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"> <ImageView
                    android:id="@+id/iv_messages_icon"
                    android:layout_width="27dp"
                    android:layout_height="33dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_message" app:tint="#757575"
                    android:contentDescription="@string/notifications_icon_description"/> <TextView
                    android:id="@+id/tv_messages"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Notifications"
                    android:textSize="16sp"
                    android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tv_notifications_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1" android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/count_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        tools:visibility="visible"/> <ImageView
                        android:id="@+id/iv_messages_chevron"
                        android:layout_width="20dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#757575"
                        android:contentDescription="@string/chevron_right_description"/> </LinearLayout>

                <LinearLayout
                    android:id="@+id/logout_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"> <ImageView
                    android:id="@+id/iv_logout_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_logout" android:layout_marginEnd="12dp"
                    app:tint="#E53935"
                    android:contentDescription="@string/logout_icon_description"/> <TextView
                    android:id="@+id/tv_logout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Log Out"
                    android:textSize="16sp"
                    android:textColor="#E53935" />

                    <ImageView
                        android:id="@+id/iv_logout_chevron"
                        android:layout_width="20dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#757575"
                        android:contentDescription="@string/chevron_right_description"/> </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"> <ImageView
            android:layout_width="31dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_home" app:tint="#FF7043"
            android:contentDescription="@string/home_nav_icon_description"/> </LinearLayout>

        <LinearLayout
            android:id="@+id/navFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"> <ImageView
            android:layout_width="22dp"
            android:layout_height="23dp"
            android:src="@drawable/ic_fave" app:tint="#9E9E90" android:contentDescription="@string/favorites_nav_icon_description"/> </LinearLayout>

        <LinearLayout
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"> <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search" app:tint="#9E9E90" android:contentDescription="@string/search_nav_icon_description"/> </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"> <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_person" app:tint="#FF7043" android:contentDescription="@string/profile_nav_icon_description"/> </LinearLayout>

    </LinearLayout>

</RelativeLayout>
